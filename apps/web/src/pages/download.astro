---
import Base from "../layouts/Base.astro";
import { InstallCommand } from "../components/InstallCommand.tsx";

const repo = "wagnerp4/wave-labs";
const releases = `https://github.com/${repo}/releases`;

// `match` is tested against release asset file names (case-insensitive).
const targets = [
  {
    id: "windows",
    os: "Windows",
    arch: "x64",
    note: "Windows 10 and 11. WebView2 is installed on first run if missing.",
    files: [
      { label: "Installer (.exe)", match: "_x64-setup\\.exe$" },
      { label: "MSI", match: "_x64.*\\.msi$" }
    ]
  },
  {
    id: "macos",
    os: "macOS",
    arch: "Apple Silicon · Intel",
    note: "macOS 12+. Builds are unsigned: right-click the app and choose Open the first time.",
    files: [
      { label: "Apple Silicon (.dmg)", match: "_aarch64\\.dmg$" },
      { label: "Intel (.dmg)", match: "_x64\\.dmg$" }
    ]
  },
  {
    id: "linux",
    os: "Linux",
    arch: "x86_64",
    note: "Ubuntu 22.04+, Fedora 39+, Arch. AppImage runs without installing.",
    files: [
      { label: "AppImage", match: "\\.AppImage$" },
      { label: ".deb", match: "\\.deb$" },
      { label: ".rpm", match: "\\.rpm$" }
    ]
  }
];
---

<Base title="Download" description="Desktop installers for wave-labs on Windows, macOS and Linux.">
  <header class="max-w-2xl">
    <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-signal-500">desktop</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Download wave-labs</h1>
    <p class="mt-4 text-base leading-relaxed text-ink-300">
      Local. No account. Installers are built by GitHub Actions from tagged releases.
    </p>
    <p id="release-meta" class="mt-3 font-mono text-[12px] text-ink-400">
      Checking the latest release…
    </p>
  </header>

  <div class="mt-10 grid gap-3 lg:grid-cols-3" data-repo={repo}>
    {
      targets.map((t) => (
        <article
          class="rounded-card border border-ink-700 bg-ink-900 p-5 shadow-card"
          data-target={t.id}
        >
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-lg font-medium">{t.os}</h2>
            <span class="font-mono text-[10px] uppercase tracking-wider text-ink-400">{t.arch}</span>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {t.files.map((f) => (
              <a
                href={`${releases}/latest`}
                target="_blank"
                rel="noreferrer"
                data-match={f.match}
                class="vl-focus inline-flex h-9 items-center rounded-md border border-ink-600 px-3 font-mono text-[12px] text-ink-100 hover:border-signal-500 hover:text-signal-400"
              >
                {f.label}
              </a>
            ))}
          </div>
          <p class="mt-4 text-sm leading-relaxed text-ink-300">{t.note}</p>
        </article>
      ))
    }
  </div>

  <p class="mt-4 font-mono text-[11px] text-ink-400">
    Older versions and checksums on <a class="text-ink-200 underline underline-offset-2 hover:text-ink-50" href={releases} target="_blank" rel="noreferrer">GitHub Releases</a>.
  </p>

  <section class="mt-14 grid gap-8 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-signal-500">engine</p>
      <h2 class="mt-3 text-xl font-semibold tracking-tight">Set up the speech engine</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-300">
        The app is the interface. Models run in a separate Python engine on
        <span class="font-mono text-ink-100">127.0.0.1:8471</span>, and it is not bundled with the
        installer yet. Until it is, the sidebar shows <span class="font-mono text-ink-100">Engine offline</span>
        until you start it.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-300">
        You need <a class="text-ink-100 underline underline-offset-2" href="https://docs.astral.sh/uv/" target="_blank" rel="noreferrer">uv</a>.
        Start the engine from a clone of the repo, or set
        <span class="font-mono text-ink-100">WAVELABS_ENGINE_DIR</span> to the clone's
        <span class="font-mono text-ink-100">engine/</span> folder and the app starts it for you.
      </p>
    </div>
    <InstallCommand client:load />
  </section>
</Base>

<script>
  type Asset = { name: string; browser_download_url: string; size: number };
  type Release = { tag_name: string; html_url: string; published_at: string; assets: Asset[] };

  const root = document.querySelector<HTMLElement>("[data-repo]");
  const meta = document.getElementById("release-meta");
  const repo = root?.dataset.repo;

  function mb(bytes: number) {
    return `${(bytes / 1024 / 1024).toFixed(0)} MB`;
  }

  async function load() {
    if (!repo || !meta) return;
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}/releases/latest`, {
        headers: { Accept: "application/vnd.github+json" }
      });
      if (res.status === 404) {
        meta.textContent = "No published release yet. Buttons open the releases page.";
        return;
      }
      if (!res.ok) throw new Error(String(res.status));
      const release = (await res.json()) as Release;
      const date = new Date(release.published_at).toLocaleDateString(undefined, {
        year: "numeric",
        month: "short",
        day: "numeric"
      });
      meta.textContent = `Latest: ${release.tag_name} · ${date}`;

      document.querySelectorAll<HTMLAnchorElement>("a[data-match]").forEach((link) => {
        const re = new RegExp(link.dataset.match ?? "$^", "i");
        const asset = release.assets.find((a) => re.test(a.name));
        if (asset) {
          link.href = asset.browser_download_url;
          link.removeAttribute("target");
          link.title = `${asset.name} · ${mb(asset.size)}`;
        } else {
          link.href = release.html_url;
        }
      });
    } catch {
      meta.textContent = "Could not reach GitHub. Buttons open the releases page.";
    }
  }

  load();
</script>
