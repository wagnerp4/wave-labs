---
import Base from "../layouts/Base.astro";
import { InstallCommand } from "../components/InstallCommand.tsx";
import { Waveform } from "@wavelabs/ui";
import { registry } from "@wavelabs/registry";

const base = import.meta.env.BASE_URL;
const tts = registry.adapters.filter((a) => a.task === "tts").length;
const asr = registry.adapters.filter((a) => a.task === "asr").length;

const workflows = [
  {
    title: "Speech studio",
    body: "Type a script, pick a voice and an engine, render to WAV. Compare engines side by side."
  },
  {
    title: "Voice clone",
    body: "Drop in a short reference clip. Clean it up, then clone with any adapter that supports it."
  },
  {
    title: "Voice design",
    body: "Describe a speaker in a sentence. Age, accent, pace, recording quality."
  },
  {
    title: "Transcripts",
    body: "Audio or video in, editable text with timestamps out. Batch folders overnight."
  },
  {
    title: "Model lab",
    body: "Pull weights from Hugging Face, check hardware compatibility, benchmark latency locally."
  },
  {
    title: "Local API",
    body: "OpenAI-compatible /v1/audio endpoints on localhost. Point existing tools at it."
  }
];
---

<Base title="Local-first speech lab">
  <section class="relative isolate">
    <div class="vl-grid-bg pointer-events-none absolute inset-x-0 -top-10 -z-10 h-[520px]"></div>

    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-signal-500">open source · local by default</p>
        <h1 class="mt-4 max-w-2xl text-5xl font-semibold leading-[1.02] tracking-tight sm:text-6xl">
          A speech lab that runs on your machine.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300">
          Text to speech, transcription, cloning and voice design with
          <span class="text-ink-50">{registry.adapters.length} adapters</span> for Hugging Face models.
          One desktop app for Linux, macOS and Windows. One local API for everything else.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={`${base}download`}
            class="vl-focus inline-flex h-11 items-center rounded-lg bg-signal-500 px-5 text-sm font-semibold text-ink-950 hover:bg-signal-400"
          >
            Download the app
          </a>
          <a
            href={`${base}models`}
            class="vl-focus inline-flex h-11 items-center rounded-lg border border-ink-600 px-5 text-sm text-ink-100 hover:border-ink-400"
          >
            Browse {tts} TTS · {asr} ASR models
          </a>
        </div>
      </div>

      <div class="rounded-card border border-ink-700 bg-ink-900/80 p-5 shadow-card">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-400">install</span>
          <Waveform live client:idle />
        </div>
        <InstallCommand client:load className="mt-4" />
      </div>
    </div>
  </section>

  <section class="mt-24">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-semibold tracking-tight">Workflows</h2>
      <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-400">desktop</span>
    </div>
    <div class="mt-6 grid gap-px overflow-hidden rounded-card border border-ink-700 bg-ink-700 sm:grid-cols-2 lg:grid-cols-3">
      {
        workflows.map((w, i) => (
          <article class="bg-ink-900 p-6">
            <span class="font-mono text-[11px] text-ink-400">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 text-base font-medium text-ink-50">{w.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-300">{w.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-24 grid gap-8 lg:grid-cols-3">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">Hardware routing you can inspect.</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-300">
        CUDA, ROCm, Apple Silicon and CPU. The app checks what an adapter can run on before you pick it.
        The catalog shows the same information here.
      </p>
    </div>
    <div class="lg:col-span-2">
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-card border border-ink-700 bg-ink-900 p-5">
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-400">developers</span>
          <h3 class="mt-2 font-medium">OpenAI-compatible local API</h3>
          <pre class="mt-3 overflow-x-auto rounded-md bg-ink-950 p-3 font-mono text-[12px] leading-relaxed text-ink-200"><code>POST http://127.0.0.1:8471/v1/audio/speech
POST http://127.0.0.1:8471/v1/audio/transcriptions
GET  http://127.0.0.1:8471/v1/models</code></pre>
        </div>
        <div class="rounded-card border border-ink-700 bg-ink-900 p-5">
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-400">models</span>
          <h3 class="mt-2 font-medium">Hugging Face first</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-300">
            Weights are pulled from the Hub into a local cache you control. No account, no telemetry.
            Licenses are listed per adapter so you can decide what fits your use.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
