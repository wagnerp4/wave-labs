---
import { Wordmark } from "@voicelabs/ui";

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const links = [
  { href: `${base}models`, label: "Models" },
  { href: `${base}docs`, label: "Docs" },
  { href: `${base}download`, label: "Download" }
];

const isActive = (href: string) => path === href || path === `${href}/`;
---

<header class="sticky top-0 z-30 border-b border-ink-800 bg-ink-950/80 backdrop-blur">
  <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href={base} class="vl-focus rounded-md" aria-label="voice-labs home">
      <Wordmark />
    </a>
    <nav class="flex items-center gap-1 text-sm">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "vl-focus rounded-md px-3 py-1.5 transition-colors hover:text-ink-50",
              isActive(l.href) ? "text-ink-50" : "text-ink-300"
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="https://github.com/heojiNn/voice-labs"
        target="_blank"
        rel="noreferrer"
        class="vl-focus ml-2 hidden items-center gap-2 rounded-md border border-ink-700 px-3 py-1.5 font-mono text-xs text-ink-200 hover:border-ink-500 sm:inline-flex"
      >
        <svg viewBox="0 0 16 16" class="size-3.5 fill-current" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
        GitHub
      </a>
      <a
        href={`${base}download`}
        class="vl-focus ml-2 inline-flex h-8 items-center rounded-md bg-signal-500 px-3 text-xs font-semibold text-ink-950 hover:bg-signal-400"
      >
        Download
      </a>
    </nav>
  </div>
</header>
