---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Local-first speech lab. TTS, transcription and voice tooling built on Hugging Face models."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · wave-labs</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:title" content={`${title} · wave-labs`} />
    <meta property="og:description" content={description} />
  </head>
  <body class="min-h-dvh bg-ink-950 text-ink-50">
    <Nav />
    <main class="mx-auto w-full max-w-6xl px-5 pb-24 pt-10 sm:px-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
