{
  "name": "wave-labs",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first speech lab: TTS, ASR and voice tooling with Hugging Face models. Website, desktop app and local API.",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @wavelabs/web dev",
    "dev:desktop": "pnpm --filter @wavelabs/desktop dev",
    "dev:desktop:tauri": "pnpm --filter @wavelabs/desktop tauri dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:web": "pnpm --filter @wavelabs/web build",
    "build:desktop": "pnpm --filter @wavelabs/desktop build",
    "build:desktop:tauri": "pnpm --filter @wavelabs/desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "registry:validate": "pnpm --filter @wavelabs/registry validate",
    "engine:sync": "uv sync --directory engine",
    "engine:serve": "uv run --directory engine wavelabs-engine serve",
    "engine:lint": "uv run --directory engine ruff check ."
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
